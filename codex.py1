name = "SARAWAT"

print("CIAO", name)
print("I am learning Python for Applied AI!")
class Student:
    def __init__(self, name, age, marks):
        self.name = name
        self.age = age
        self.marks = marks

    def display(self):
        print(f"Name: {self.name}, Age: {self.age}, Marks: {self.marks}")

    def results(self):
        if self.marks >= 40:
            print(f"{self.name} passed")
        else:
            print(f"{self.name} failed")

            
s1 = Student("Alex", 17, 85)
s1.display()
Name: Alex, Age: 17, Marks: 85
s1.results()
Alex passed
s2 = Student("Sam", 17, 32)
s2.display()
s2.results()
#INHERITANCE
class Student:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    def display(self):
        print(self.name, self.marks)


class AIStudent(Student):
    def ai_skill(self):
        print(self.name, "knows Python and AI")


s1 = AIStudent("Alex", 85)

s1.display()
s1.ai_skill()
class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def info(self):
        print(self.name, self.age)


class Student(Person):
    def __init__(self, name, age, subject):
        super().__init__(name, age)
        self.subject = subject

    def study(self):
        print(f"{self.name} is studying {self.subject}")


s1 = Student("Alex", 17, "CS")

s1.info()
s1.study()
